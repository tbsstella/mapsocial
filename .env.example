# Copy to .env.local and fill in as needed. All variables are optional;
# see the "Environment variables" section in the README.

# Uniswap Trading API key (direct execution for the built-in SIMN swap;
# free at https://hub.uniswap.org)
UNISWAP_API_KEY=

# Alchemy API key (unified RPC for all five chains; free at
# https://dashboard.alchemy.com). Server-side reads use ALCHEMY_API_KEY;
# browser-side reads use NEXT_PUBLIC_ALCHEMY_API_KEY (exposed to the frontend —
# consider domain allowlisting in the Alchemy dashboard). Both can be the same key.
ALCHEMY_API_KEY=
NEXT_PUBLIC_ALCHEMY_API_KEY=

# Avatar image compliance check (omni-moderation); required in production
OPENAI_API_KEY=

# LicenseStake contract address (when unset, event/bot creation passes in dev mode)
LICENSE_STAKE_CONTRACT=

# Per-chain RPC overrides (take priority over Alchemy; usually not needed)
ETHEREUM_RPC=
POLYGON_RPC=
ARBITRUM_RPC=
ROBINHOOD_RPC=
HYPEREVM_RPC=

# Fallback prices when CoinGecko is unavailable
PRICE_ETH=
PRICE_POL=
PRICE_HYPE=

# IP intelligence service URL (defaults to ip-api.com)
IP_CHECK_URL=

# Minimum vibes score to create events (default 0)
EVENT_MIN_TRUST=
