# 复制为 .env.local 并按需填写。所有变量均为可选，详见 README「环境变量」。

# Uniswap Trading API key（内置 SIMN 兑换直接成交用；https://hub.uniswap.org 免费申请）
UNISWAP_API_KEY=

# Alchemy API key（统一五条链的 RPC；https://dashboard.alchemy.com 免费申请）
# 服务端读链用 ALCHEMY_API_KEY；浏览器端读链用 NEXT_PUBLIC_ALCHEMY_API_KEY（会暴露给前端，
# 建议在 Alchemy 后台按域名加白）。两处可填同一个 key。
ALCHEMY_API_KEY=
NEXT_PUBLIC_ALCHEMY_API_KEY=

# 头像图片合规审核（omni-moderation）；生产必须配置
OPENAI_API_KEY=

# LicenseStake 合约地址（未配置时活动/Bot 创建走 dev 放行）
LICENSE_STAKE_CONTRACT=

# 单独覆盖某条链的 RPC（优先级高于 Alchemy；一般不需要）
ETHEREUM_RPC=
POLYGON_RPC=
ARBITRUM_RPC=
ROBINHOOD_RPC=
HYPEREVM_RPC=

# CoinGecko 不可用时的兜底价格
PRICE_ETH=
PRICE_POL=
PRICE_HYPE=

# IP 情报服务地址（默认 ip-api.com）
IP_CHECK_URL=

# 创建活动的最低靠谱值（默认 0）
EVENT_MIN_TRUST=
